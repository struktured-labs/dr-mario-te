# Virtual environment
.venv/

# Python cache
__pycache__/
*.pyc

# ROMs (don't commit copyrighted content)
*.nes

# Emulator save states and configs
*.sav
*.srm
*.state

# Scratch / scratchpad (ad-hoc debug + cross-check harnesses)
tmp/
log/
setenv.sh

# transient emulator/run logs
*.log
mesen*.log

# expansion test ROMs
drmario_exp.nes
/tmp/
drmario_v28cs_exp.nes
drmario_banktest.nes
drmario_cart.nes

# recorded gameplay clips (large binaries)
*.mp4
# agent scratch
.letta/

# Verilator build outputs — generated, never source. Tracking these kept the tree
# permanently dirty, which made the provenance dirty-check fire on every build and
# trained us to ignore the one signal that matters.
fpga/copro/obj_mister/
fpga/copro/obj_leafeval/
fpga/copro/build/
fpga/copro/obj_*/
