# sileval_oldbox.env — POPULATION B (AMENDMENT 1: host migration to the OLD box).
# Same driver kernel as population A; only this env and OUT_DIR differ.
#
# IDENTITY IS BY CONTENT + MAC, NEVER BY IP. Both boxes now carry a
# SILEVAL_BOX_ID sentinel, so existence proves nothing; leases have already
# moved once (.225 <-> .233). The md5 and MAC below are machine properties.
NEWMISTER_IP=10.42.0.225           # target = the OLD box (experiments box)
LIVE_MISTER_IP=10.42.0.233         # FORBIDDEN: owner's TV/play box. Driver hard-stops if equal.
EXPECT_MAC=02:03:04:05:06:07       # OLD box, stock MAC
FORBIDDEN_MAC=02:53:49:4c:45:56    # NEW box "SILEV" MAC — refuse on sight, whatever its IP
EXPECT_BOX_ID_MD5=cbe0bdbbb5141b9eee874bb0efd7dd39             # OLD box's own sentinel (distinct string from the new box's)

# Template: UNCHANGED and identically pinned. Note this template was captured in
# the OLD box's live-soak era, so population B restores it to its native host.
TEMPLATE_SHIP=$HOME/projects/dr-mario-sileval-wt/experiments/sileval/vendor/seedjit_template_0d9e7b2f.ss
TEMPLATE_SHIP_MD5=0d9e7b2fad7ea47869ea3f8c41e787f8
TEMPLATE_SLICE=$HOME/projects/dr-mario-sileval-wt/experiments/sileval/vendor/seedjit_template_0d9e7b2f.ss
TEMPLATE_SLICE_MD5=0d9e7b2fad7ea47869ea3f8c41e787f8

# Registered artifact hashes (do not edit) — verified on-card on the OLD box.
CART_SHIP_MD5=9fefaedba9a27ba10f058ac239eeb77d
CART_SLICE_MD5=010f4ffe350df3b57561f8ce3bc4320b
RBF_MD5=de7dea35a9fa03a622cccc8068bd935e

# SD paths on the OLD box. MGLs are the OLD-Main idiom (index="1", relative):
# this box runs Main 2024-05-07, NOT 260707 — the MGL hazard runs the other way
# here, and the format was motion-verified on this box before row 1.
SD_CART_SHIP=/media/fat/games/NES/drmario_tcvc_ship_9fefaedb.nes
SD_CART_SLICE=/media/fat/games/NES/drmario_tcvc_p1slice_010f4ffe.nes
SD_RBF=/media/fat/_Console/NES_theta400_20260809.rbf
SD_MGL_SHIP=/media/fat/sileval_ship.mgl
SD_MGL_SLICE=/media/fat/sileval_p1slice.mgl

# Timing — unchanged from the registered design.
CYCLE_SECS=240
SAMPLE_SECS=5

# SEPARATE output tree: a shared out/ would let resume skip B's seeds against
# A's rows and silently merge two populations (AMENDMENT 1 section 3.1).
OUT_DIR=$HOME/projects/dr-mario-sileval-wt/experiments/sileval/out_oldbox/probe5s
SEEDS_FILE=$HOME/projects/dr-mario-sileval-wt/experiments/sileval/seeds_sileval.txt
