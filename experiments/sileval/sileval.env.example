# sileval.env — the ONLY place the new box's identity lives. Copy to sileval.env
# (gitignored) and fill in. The driver refuses to run with placeholders.
#
# EXPLICIT IP ONLY. Never discovery: both MiSTers ship the same default MAC
# (02:03:04:05:06:07), so ARP/mDNS cannot tell the NEW box from the LIVE soak
# box. mister_ip.sh belongs to the live box and is never called here.
NEWMISTER_IP=FILL_ME_IN            # owner supplies; lease WANDERS (.225 -> .233 observed
                                   # across the 03:00-UTC update reboots). The box now has a
                                   # UNIQUE locally-administered MAC 02:53:49:4c:45:56
                                   # (spells "SILEV"), so MAC-scan re-discovery is safe for
                                   # THIS box; the sentinel check remains the identity proof.
LIVE_MISTER_IP=10.42.0.226         # guard: driver hard-stops if NEWMISTER_IP == this

# Pinned after template capture on the NEW box (runbook step 6). Rows are VOID
# until these are real md5s.
TEMPLATE_SHIP=                     # path to ship-arm pre-generation template .ss
TEMPLATE_SHIP_MD5=
TEMPLATE_SLICE=                    # path to slice-arm pre-generation template .ss
TEMPLATE_SLICE_MD5=

# Registered artifact hashes (do not edit)
CART_SHIP_MD5=9fefaedba9a27ba10f058ac239eeb77d
CART_SLICE_MD5=010f4ffe350df3b57561f8ce3bc4320b
RBF_MD5=de7dea35a9fa03a622cccc8068bd935e

# SD paths on the NEW box (keep-versions naming; set by stage/OWNER copy step)
SD_CART_SHIP=/media/fat/games/NES/drmario_tcvc_ship_9fefaedb.nes
SD_CART_SLICE=/media/fat/games/NES/drmario_tcvc_p1slice_010f4ffe.nes
SD_RBF=/media/fat/_Console/NES_theta400_20260809.rbf
SD_MGL_SHIP=/media/fat/sileval_ship.mgl
SD_MGL_SLICE=/media/fat/sileval_p1slice.mgl

# Timing
CYCLE_SECS=360
SAMPLE_SECS=20

# Output root (gitignored; one JSONL row per (seed,arm) + artifacts per row)
OUT_DIR=$HOME/projects/dr-mario-sileval-wt/experiments/sileval/out
SEEDS_FILE=$HOME/projects/dr-mario-sileval-wt/experiments/sileval/seeds_sileval.txt
